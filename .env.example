# ── Required ────────────────────────────────────────────────
# Gemini API key — get one free at https://aistudio.google.com/apikey
# (used for recipe generation AND AI dish photography)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ────────────────────────────────────────────────
# YouTube Data API v3 key — enables specific, ranked video
# tutorials per recipe. Without it, recipes link to an honest
# YouTube search instead. https://console.cloud.google.com
YOUTUBE_API_KEY=
